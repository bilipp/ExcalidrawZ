
// Upstream defaults. Do not put personal signing values here — add them to
// Overrides.xcconfig instead (gitignored), which is included last and wins.

DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.chocoford
APP_BUNDLE_NAME = excalidraw
ICLOUD_CONTAINER = iCloud.com.chocoford.excalidraw
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX).$(APP_BUNDLE_NAME)

// Local settings take precedence over the defaults above.
#include? "Overrides.xcconfig"
